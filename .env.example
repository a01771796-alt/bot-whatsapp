# ============================================================
# Copia este archivo y renombra la copia a ".env"
# Luego rellena cada valor con los datos reales del negocio.
# NUNCA subas el archivo ".env" (el real, con tus datos) a internet
# ni lo compartas por WhatsApp/correo: son tus llaves privadas.
# ============================================================

# --- WhatsApp Cloud API (te lo da Meta al configurar tu numero de WhatsApp Business) ---
WHATSAPP_TOKEN=el_token_que_te_da_meta
WHATSAPP_PHONE_NUMBER_ID=el_id_de_tu_numero_de_whatsapp
# Este "verify token" NO te lo da nadie: lo INVENTAS tu mismo (cualquier palabra secreta).
# Lo vas a escribir dos veces: aqui, y en el panel de Meta cuando configures el webhook.
WHATSAPP_VERIFY_TOKEN=una_palabra_secreta_que_tu_inventas

# --- Claude / Anthropic (la inteligencia artificial que redacta las respuestas) ---
ANTHROPIC_API_KEY=tu_llave_de_anthropic

# --- Datos del negocio ---
NOMBRE_NEGOCIO=Cafeteria Ejemplo
# Numero de WhatsApp del DUENO o encargado, con codigo de pais, sin espacios ni "+"
# Ejemplo Mexico: 5215512345678
OWNER_WHATSAPP_NUMBER=5215512345678
# Plantilla de RESPALDO para los avisos al dueño (tickets, pedidos). Si el
# dueño no le ha escrito al bot en las últimas 24 h, Meta rechaza el texto
# libre y el aviso se manda por esta plantilla (categoría Utility, ver
# README_INSTALACION.md, "Avisos al dueño fuera de la ventana de 24 h").
# La bandera "_APROBADA" se queda en false HASTA que confirmes en WhatsApp
# Manager que la plantilla quedó en estado "Approved".
WHATSAPP_PLANTILLA_AVISO_DUENO=
WHATSAPP_PLANTILLA_AVISO_DUENO_APROBADA=false

# Link de tu Google Sheet publicado como CSV (instrucciones en README_INSTALACION.md)
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXXXXXXXXXXXXXX/pub?output=csv

# OPCIONAL: link a una SEGUNDA pestaña del mismo Sheet (o de otro), publicada
# tambien como CSV, donde tu y el dueño agregan preguntas que el bot no supo
# contestar junto con la respuesta correcta. Si no la configuras, el bot
# simplemente no usa esta parte (ver README_INSTALACION.md, sección de
# "ciclo de aprendizaje").
GOOGLE_SHEET_APRENDIZAJE_CSV_URL=

# --- Dashboard de tickets (sistema de casos escalados) ---
# La URL publica de tu servidor (la que te da Railway en el Paso 4 del manual
# de instalacion). Se usa para armar los links de "en revisión"/"resuelto"
# que se le mandan al dueño por WhatsApp. Ejemplo: https://tu-bot.up.railway.app
URL_PUBLICA_DEL_SERVIDOR=

# Otra palabra secreta que TU inventas (distinta a WHATSAPP_VERIFY_TOKEN).
# Protege el dashboard y los links de accion para que solo quien tenga el
# link real (el dueño, por WhatsApp) pueda verlos o usarlos.
TOKEN_DASHBOARD=otra_palabra_secreta_que_tu_inventas

# Puerto del servidor (normalmente no hay que tocar esto)
PORT=3000

# --- Motor de reseñas post-pedido (SOLO Motor B, ver orders.js) -----------
# Las recogidas son el mismo dia (minutos/horas de anticipacion), no aplica
# Motor A (recordatorios de anticipacion tipo 24h/2h) -- no lo actives aqui,
# no tiene caso para este giro (ver la tabla de Precedentes en el CLAUDE.md
# general).
ZONA_HORARIA=America/Mexico_City

# Solicitud de reseña despues de marcar el pedido como "entregado" en
# /pedidos del dashboard. Espera 30 minutos (los pedidos de comida se
# consumen rápido -- se pide la reseña mientras la experiencia está fresca).
ACTIVAR_SOLICITUD_RESENA=false
RESENA_ESPERA_HORAS=0.5
WHATSAPP_PLANTILLA_RESENA=
WHATSAPP_PLANTILLA_RESENA_APROBADA=false
WHATSAPP_IDIOMA_PLANTILLA=es_MX
